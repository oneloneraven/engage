// Bindings are repeated in every environment: an environment that omits one does not inherit it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "engage",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ENV": "development",
    "ADMIN_HOST": "localhost",
    "PUBLIC_HOST": "127.0.0.1",
    "ADMIN_ACCESS_CHECK": "off"
  },
  "env": {
    "production": {
      "vars": {
        "APP_ENV": "production",
        "ADMIN_HOST": "engage.oneloneraven.com",
        "PUBLIC_HOST": "engage-api.oneloneraven.com",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": ""
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      },
      "routes": [
        { "pattern": "engage.oneloneraven.com/*", "zone_name": "oneloneraven.com" },
        { "pattern": "engage-api.oneloneraven.com/*", "zone_name": "oneloneraven.com" }
      ]
    },
    "preview": {
      "vars": {
        "APP_ENV": "preview"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      },
      "workers_dev": true,
      "preview_urls": true,
      // A PR Preview inherits none of the above, so it repeats what the app needs.
      "previews": {
        "vars": {
          "APP_ENV": "preview"
        }
      }
    },
    "e2e": {
      "vars": {
        "APP_ENV": "e2e",
        "ADMIN_HOST": "localhost",
        "PUBLIC_HOST": "127.0.0.1",
        "ADMIN_ACCESS_CHECK": "off"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      }
    }
  }
}
